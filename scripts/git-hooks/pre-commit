#!/usr/bin/env bash
# ==============================================================================
# Pre-commit hook for pov-oversight-agent
# Prevents cross-contamination from ai-memory repo and workspace files
#
# Activation: git config core.hooksPath scripts/git-hooks
# Bypass:     git commit --no-verify -m "message"
# ==============================================================================
set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

ERRORS=0
WARNINGS=0

# Get list of staged files (added, copied, modified, renamed)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

echo "--- pov-oversight-agent pre-commit checks ---"

# CHECK 1: No files from ai-memory's unique directories
AI_MEMORY_DIRS="^(src/|tests/|docker/|monitoring/|examples/|backups/|templates/)"
VIOLATIONS=$(echo "$STAGED_FILES" | grep -E "$AI_MEMORY_DIRS" || true)
if [ -n "$VIOLATIONS" ]; then
    echo -e "${RED}BLOCKED: Staged files match ai-memory directory patterns:${NC}"
    echo "$VIOLATIONS"
    echo "These directories belong to the ai-memory repo, not pov-oversight-agent."
    ERRORS=$((ERRORS + 1))
fi

# CHECK 2: No ai-memory-specific root files
AI_MEMORY_FILES="^(pyproject\.toml|requirements\.txt|requirements-dev\.txt|package\.json|package-lock\.json|uv\.lock|pytest\.ini|pytest-e2e\.ini|playwright\.config\.ts|REPO_SETUP\.md|TROUBLESHOOTING\.md|update\.sh)$"
VIOLATIONS=$(echo "$STAGED_FILES" | grep -E "$AI_MEMORY_FILES" || true)
if [ -n "$VIOLATIONS" ]; then
    echo -e "${RED}BLOCKED: Staged files match ai-memory-specific filenames:${NC}"
    echo "$VIOLATIONS"
    ERRORS=$((ERRORS + 1))
fi

# CHECK 3: Warning on Python files (canary check)
# Remove this check when orchestration scripts are intentionally added
PY_FILES=$(echo "$STAGED_FILES" | grep '\.py$' || true)
if [ -n "$PY_FILES" ]; then
    echo -e "${YELLOW}WARNING: Python files staged in pov-oversight-agent:${NC}"
    echo "$PY_FILES"
    echo "If these are intentional orchestration scripts, update .gitignore to allow them."
    WARNINGS=$((WARNINGS + 1))
fi

# CHECK 4: No absolute workspace paths in file content
# Exclude files that legitimately use these patterns as search strings
EXCLUDE_FROM_PATH_CHECK="scripts/git-hooks/pre-commit|\.github/workflows/"
for f in $STAGED_FILES; do
    if echo "$f" | grep -qE "$EXCLUDE_FROM_PATH_CHECK"; then
        continue
    fi
    # Only check text files, skip binary
    if file "$f" 2>/dev/null | grep -q "text"; then
        if git show ":$f" 2>/dev/null | grep -nE '/mnt/e/projects/|/dev-multi-agent/' > /dev/null 2>&1; then
            echo -e "${RED}BLOCKED: File '$f' contains absolute workspace path:${NC}"
            git show ":$f" | grep -nE '/mnt/e/projects/|/dev-multi-agent/' | head -5
            ERRORS=$((ERRORS + 1))
        fi
    fi
done

# CHECK 5: No workspace-only directory names in paths
WORKSPACE_DIRS="^(oversight/|_bmad/|_bmad-output/)"
VIOLATIONS=$(echo "$STAGED_FILES" | grep -E "$WORKSPACE_DIRS" || true)
if [ -n "$VIOLATIONS" ]; then
    echo -e "${RED}BLOCKED: Staged files from workspace-only directories:${NC}"
    echo "$VIOLATIONS"
    echo "These directories are workspace-only and should never be committed."
    ERRORS=$((ERRORS + 1))
fi

# RESULTS
if [ $ERRORS -gt 0 ]; then
    echo ""
    echo -e "${RED}Pre-commit check FAILED with $ERRORS error(s).${NC}"
    echo "This likely means files from the wrong repo or workspace were staged."
    echo ""
    echo "Fix: git reset HEAD <file>  (unstage wrong files)"
    echo "Bypass: git commit --no-verify  (CI will still catch issues)"
    echo "Verify: git remote -v  (confirm you're in pov-oversight-agent)"
    exit 1
fi

if [ $WARNINGS -gt 0 ]; then
    echo -e "${YELLOW}Pre-commit passed with $WARNINGS warning(s).${NC}"
else
    echo -e "${GREEN}All pre-commit checks passed.${NC}"
fi

exit 0
